# Copy to .env and fill in. Never commit .env.
# Database password (any long random string), e.g.  openssl rand -base64 24
POSTGRES_PASSWORD=
# At least 32 random characters, e.g.  openssl rand -base64 48
WHITEBOARD_SESSION_SECRET=
# Admin password hash, see README ("Admin password")
WHITEBOARD_ADMIN_PASSWORD_HASH=
# Optional: token for the REST API (/v2) and the Python client, e.g.  openssl rand -hex 32
WHITEBOARD_API_TOKEN=
# Optional
PUBLIC_URL=http://localhost:1337
WHITEBOARD_LANGUAGE=en
WHITEBOARD_ADMIN_NAME=Admin
PORT=1337
