{
  "name": "postit-chaos",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build -w frontend && npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "start": "npm start -w backend",
    "dev:backend": "npm run dev -w backend",
    "watch:frontend": "npm run watch -w frontend",
    "test:unit": "vitest --run",
    "test:integration": "TEST_TARGET=integration vitest --run",
    "prettier:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/uuid": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "uuid": "^14.0.3"
  },
  "overrides": {
    "@types/express": "^4.17.23",
    "@types/express-serve-static-core": "^4.19.9"
  }
}
