DATABASE_URL=postgres://postitchaos@127.0.0.1:5432/postitchaos
HOST=127.0.0.1
PORT=1337
PUBLIC_URL=http://127.0.0.1:1337
ASSETS_DIR=./localfiles
# Pflicht: mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 48`
WHITEBOARD_SESSION_SECRET=
# Admin-Passwort-Hash, erzeugt mit scripts/hash-password.mjs (siehe README)
WHITEBOARD_ADMIN_PASSWORD_HASH=
# Bearer-Token der Board-API (/v2, REST API), kommt mit dem API-Branch
WHITEBOARD_API_TOKEN=
# Optional: Anzeigename des Admins im Board (Standard: Admin)
WHITEBOARD_ADMIN_NAME=
# Optional, nur für S3-Asset-Speicher (zusammen mit AWS_ASSETS_BUCKET_URL)
S3_BUCKET=
S3_REGION=
# Optional: UI language, "en" (default) or "de". Browsers can override it with ?lang=de|en
WHITEBOARD_LANGUAGE=en
